+// Cubiq start - Leave out bundled code that the server never uses and whose license the FSF lists as incompatible with
+// the GPL (see the decisions in docs/LICENSING.md): Eclipse Sisu Inject (EPL 1.0), which the bundled Maven classes only
+// name in annotations, and the 32-bit macOS library of jline-native, which contains Apple's startup code under the
+// APSL 2.0 and which no Java 25 runtime loads. The bundler jar, which the Paperclip jar is made from, gets jline-native
+// without that library, with its other entries in their order and with their times so that builds stay reproducible,
+// and its hash in META-INF/libraries.list.
+configurations.runtimeClasspath {
+    exclude(group = "org.eclipse.sisu", module = "org.eclipse.sisu.inject")
+}
+tasks.withType<io.papermc.paperweight.tasks.CreateBundlerJar>().configureEach {
+    val bundlerJar = outputZip
+    doLast {
+        val jar = bundlerJar.get().asFile.toPath()
+        val rewritten = jar.resolveSibling(jar.fileName.toString() + ".rewritten")
+        ZipFile(jar.toFile()).use { input ->
+            val entries = input.entries().toList()
+            val jlineNative = entries.single { Regex("META-INF/libraries/org/jline/jline-native/[^/]+/jline-native-[^/]+\\.jar").matches(it.name) }
+            val stripped = ByteArrayOutputStream()
+            ZipInputStream(input.getInputStream(jlineNative)).use { library ->
+                ZipOutputStream(stripped).use { out ->
+                    while (true) {
+                        val entry = library.nextEntry ?: break
+                        if (entry.name.startsWith("org/jline/nativ/Mac/x86/")) {
+                            continue
+                        }
+                        val copy = ZipEntry(entry.name)
+                        copy.setTimeLocal(entry.timeLocal)
+                        out.putNextEntry(copy)
+                        library.copyTo(out)
+                        out.closeEntry()
+                    }
+                }
+            }
+            val strippedBytes = stripped.toByteArray()
+            val hash = MessageDigest.getInstance("SHA-256").digest(strippedBytes).joinToString("") { "%02x".format(it) }
+            val path = jlineNative.name.removePrefix("META-INF/libraries/")
+            ZipOutputStream(Files.newOutputStream(rewritten)).use { output ->
+                for (entry in entries) {
+                    val content = when (entry.name) {
+                        jlineNative.name -> strippedBytes
+                        "META-INF/libraries.list" -> input.getInputStream(entry).readBytes().toString(Charsets.UTF_8).lines().joinToString("\n") { line ->
+                            val fields = line.split("\t")
+                            if (fields.size == 3 && fields[2] == path) "$hash\t${fields[1]}\t${fields[2]}" else line
+                        }.toByteArray(Charsets.UTF_8)
+                        else -> input.getInputStream(entry).readBytes()
+                    }
+                    val copy = ZipEntry(entry.name)
+                    copy.setTimeLocal(entry.timeLocal)
+                    if (entry.method == ZipEntry.STORED) {
+                        val crc = CRC32()
+                        crc.update(content)
+                        copy.method = ZipEntry.STORED
+                        copy.size = content.size.toLong()
+                        copy.compressedSize = content.size.toLong()
+                        copy.crc = crc.value
+                    }
+                    output.putNextEntry(copy)
+                    output.write(content)
+                    output.closeEntry()
+                }
+            }
+        }
+        Files.move(rewritten, jar, StandardCopyOption.REPLACE_EXISTING)
+    }
+}
+// Cubiq end - Leave out bundled code that the server never uses and whose license the FSF lists as incompatible with the GPL
