+// Cubiq start - The Paperclip jar is what server owners download: ship the license texts and notices in it as well,
+// and make it reproducible. paperweight stores the build time in every entry and writes the entries in the order of
+// the file system, so the entries are rewritten in a fixed order with a fixed time, as Gradle does for its archives.
+val cubiqPaperclipLicenses = tasks.register<Zip>("cubiqPaperclipLicenses") {
+    description = "Collects the license texts and notices for the Paperclip jar"
+    archiveFileName = "paperclip-licenses.zip"
+    destinationDirectory = layout.buildDirectory.dir("tmp/cubiqPaperclipLicenses")
+    isPreserveFileTimestamps = false
+    isReproducibleFileOrder = true
+    into("META-INF/license") {
+        with(cubiqLicenseFiles)
+    }
+}
+tasks.createPaperclipJar {
+    inputZip = cubiqPaperclipLicenses.flatMap { it.archiveFile }
+    val paperclipJar = outputZip
+    doLast {
+        val jar = paperclipJar.get().asFile.toPath()
+        val normalized = jar.resolveSibling(jar.fileName.toString() + ".normalized")
+        ZipFile(jar.toFile()).use { input ->
+            val entries = input.entries().toList().sortedWith(
+                compareBy<ZipEntry>({ it.name != "META-INF/" }, { it.name != "META-INF/MANIFEST.MF" }, { it.name })
+            )
+            ZipOutputStream(Files.newOutputStream(normalized)).use { output ->
+                for (entry in entries) {
+                    val copy = ZipEntry(entry.name)
+                    copy.setTimeLocal(LocalDateTime.of(1980, 2, 1, 0, 0))
+                    if (entry.method == ZipEntry.STORED) {
+                        copy.method = ZipEntry.STORED
+                        copy.size = entry.size
+                        copy.compressedSize = entry.size
+                        copy.crc = entry.crc
+                    }
+                    output.putNextEntry(copy)
+                    input.getInputStream(entry).use { it.copyTo(output) }
+                    output.closeEntry()
+                }
+            }
+        }
+        Files.move(normalized, jar, StandardCopyOption.REPLACE_EXISTING)
+    }
+}
+// Cubiq end - Reproducible Paperclip jar with license texts and notices
 
